# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ==============================================================================
# SPARK ML PIPELINE SPECIFIC
# ==============================================================================

# Generated plots
plots/
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# Feature importance files
feature_importance/
feature_*.csv

# Evaluation results
evaluation/
eval_results/
predictions/
*.evaluation

# Hyperparameter tuning results
hyperparameter_results/
optuna_study/
*.study

# Model artifacts
model_artifacts/
trained_models/

# ==============================================================================
# CONFIGURATION FILES (Keep templates, ignore actual configs)
# ==============================================================================

# Keep config templates but ignore actual configs with secrets
config.local.yaml
config.prod.yaml
config.dev.yaml
secrets.yaml
.secrets

# Environment specific
.env.local
.env.production
.env.development

# ==============================================================================
# SYSTEM & RUNTIME FILES
# ==============================================================================

# Java
*.class
*.jar

# Scala
*.scala~

# SBT
target/
project/target/
project/project/

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ==============================================================================
# SECURITY & CREDENTIALS
# ==============================================================================

# API keys and credentials
*.key
*.pem
*.crt
*.csr
credentials/
secrets/
.aws/
.azure/

# ==============================================================================
# PERFORMANCE & MONITORING
# ==============================================================================

# Profiling
*.prof
profile/

# Memory dumps
*.hprof
*.dump

# ==============================================================================
# CUSTOM PROJECT EXCLUSIONS
# ==============================================================================

# Test files (if you want to exclude them)
test_data/
sample_data/

# Documentation builds
docs/build/

# Fix and utility scripts (temporary)
fix_*.py
temp_*.py
test_*.py
debug_*.py
MLFLOW_FIX_SUMMARY.md
GIT_FILES_SUMMARY.md

# Setup scripts that are temporary
setup.py

# Shell scripts (keep run_training.sh and start_mlflow_ui.sh but exclude others)
# Uncomment the line below if you want to exclude shell scripts
# *.sh

# Large model files
*.model
*.bin

# Cache directories
.cache/
cache/

# ==============================================================================
# KEEP THESE FILES (explicitly track important files)
# ==============================================================================

# Important: Use ! to force include essential files
!config/config.yaml
!requirements.txt
!README.md
!IMPLEMENTATION_SUMMARY.md
!QUICK_REFERENCE.md
!setup.py
!src/
!scripts/
!config/

# ==============================================================================
# FINAL NOTES
# ==============================================================================

# This .gitignore excludes:
# - All model artifacts and MLflow tracking
# - All data files (CSV, parquet, etc.)
# - All generated outputs (plots, results, logs)
# - All temporary and cache files
# - All IDE and system files
# - All credentials and secrets

# This .gitignore keeps:
# - Source code (src/)
# - Scripts (scripts/) 
# - Configuration templates
# - Documentation
# - Requirements and setup files